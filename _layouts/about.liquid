<!doctype html>
<html lang="en">
  <head>
    {% include google-analytics.liquid %}
    {% include metadata.liquid %}
    {% include site-style.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/gallery.css' | relative_url }}">
    <script src="{{ '/assets/js/gallery.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      {% include site-nav.liquid %}
      <main id="main">
        <section class="intro" aria-labelledby="name">
          <header class="intro-heading">
            <h1 id="name">
              {{ site.first_name }}
              {{ site.middle_name }}
              {{ site.last_name }}
            </h1>
            <p class="subtitle">{{ page.subtitle }}</p>
          </header>
          <div class="biography">{{ content }}</div>
          <figure class="portrait">
            <img
              src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
              alt="Dechen Gao"
              width="228"
              height="285"
              fetchpriority="high"
            >
          </figure>
          <div class="social-links" aria-label="Social links">
            <a href="mailto:dechengao@gmail.com"><i class="fa-solid fa-envelope" aria-hidden="true"></i>Email</a>
            <a href="https://scholar.google.com/citations?user=a-Dp92MAAAAJ&amp;hl=en"
              ><i class="ai ai-google-scholar" aria-hidden="true"></i>Google Scholar</a
            >
            <a href="https://github.com/gaodechen"><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a>
            <a href="https://www.linkedin.com/in/gao-dechen/"><i class="fa-brands fa-linkedin" aria-hidden="true"></i>LinkedIn</a>
          </div>
        </section>

        {% if page.announcements and page.announcements.enabled %}
          <section id="news" class="news-section" aria-labelledby="news-title">
            <h2 id="news-title"><a href="{{ '/news/' | relative_url }}">News</a></h2>
            {% include news.liquid limit=true %}
          </section>
        {% endif %}

        <div class="credentials">
          <section id="experience" aria-labelledby="experience-title">
            <h2 id="experience-title">Experience</h2>
            {% include resume/work.liquid data=site.data.resume.work %}
          </section>
          <section id="education" aria-labelledby="education-title">
            <h2 id="education-title">Education</h2>
            {% include resume/education.liquid data=site.data.resume.education %}
          </section>
        </div>

        {% if page.selected_papers %}
          <section class="research" id="research" aria-labelledby="research-title">
            <div class="section-heading">
              <h2 id="research-title"><a href="{{ '/publications/' | relative_url }}">Selected Publications</a></h2>
              <a class="show-all-link" href="{{ "/publications/" | relative_url }}">Show All <span aria-hidden="true">↗</span></a>
            </div>
            <div class="research-list">{% bibliography --group_by none --template home-paper --query @*[selected=true]* %}</div>
          </section>
        {% endif %}
        {% include gallery.liquid %}
      </main>
      {% include site-footer.liquid %}
    </div>
  </body>
</html>
