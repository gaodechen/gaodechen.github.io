<!doctype html>
<html lang="{{ site.lang }}" data-site-appearance="light">
  <head>
    {% include google-analytics.liquid %}
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <body class="site-subpage">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      {% include site-nav.liquid %}

      <main id="main" class="site-content">
        {% if page.toc and page.toc.sidebar %}
          {% if page.toc.sidebar == 'right' %}
            <div class="row">
              <div class="col-sm-9">{{ content }}</div>

              <div class="col-sm-3">
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>
            </div>
          {% else %}
            <div class="row">
              <div class="col-sm-3">
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>

              <div class="col-sm-9">{{ content }}</div>
            </div>
          {% endif %}
        {% else %}
          {{ content }}
        {% endif %}
      </main>

      {% include site-footer.liquid %}
    </div>

    {% include scripts.liquid %}
  </body>
</html>
