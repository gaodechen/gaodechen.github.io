<section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery-heading">
    <h2 id="gallery-title">Gallery<span class="gallery-title-dot" aria-hidden="true">.</span></h2>
  </div>
  <div class="gallery-grid" id="gallery-grid">
    {% assign gallery_photos = site.data.gallery | where_exp: 'photo', 'photo.disabled != true' %}
    {% for photo in gallery_photos %}
      <a
        class="gallery-tile"
        href="{{ photo.file | prepend: '/assets/gallery/' | relative_url }}"
        data-gallery-item
        {% if forloop.index > 12 %}
          hidden
        {% endif %}
        data-color="{{ photo.color }}"
        data-width="{{ photo.width }}"
        data-height="{{ photo.height }}"
        aria-label="Open photograph: {{ photo.alt | escape }}"
        aria-haspopup="dialog"
        aria-controls="gallery-dialog"
      >
        <img
          src="{{ photo.file | prepend: '/assets/gallery/' | relative_url }}"
          alt="{{ photo.alt | escape }}"
          width="{{ photo.width }}"
          height="{{ photo.height }}"
          loading="lazy"
          decoding="async"
        >
        <span class="gallery-expand" aria-hidden="true">↗</span>
      </a>
    {% endfor %}
  </div>
  <div class="gallery-actions">
    <button class="gallery-toggle" type="button" aria-expanded="false" aria-controls="gallery-grid" hidden>
      Show all photos <span aria-hidden="true">↓</span>
    </button>
  </div>
  <noscript>
    <style>
      #gallery .gallery-tile[hidden] {
        display: block;
      }
    </style>
  </noscript>
</section>

<dialog class="gallery-dialog" id="gallery-dialog" aria-label="Photo gallery" aria-describedby="gallery-status">
  <header class="gallery-toolbar">
    <span class="gallery-dialog-title">Gallery<span aria-hidden="true">.</span></span>
    <p class="gallery-status" id="gallery-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <button class="gallery-close gallery-control" type="button" aria-label="Close gallery" autofocus>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 6 12 12M6 18 18 6" />
      </svg>
    </button>
  </header>
  <div class="gallery-stage">
    <button class="gallery-previous gallery-control" type="button" aria-label="Previous photograph">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m14 5-7 7 7 7" />
      </svg>
    </button>
    <figure class="gallery-photo-frame">
      <img class="gallery-lightbox-image" alt="">
      <p class="gallery-image-error" role="alert" hidden>This photograph couldn’t load. Try the next one.</p>
    </figure>
    <button class="gallery-next gallery-control" type="button" aria-label="Next photograph">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m10 5 7 7-7 7" />
      </svg>
    </button>
  </div>
  <div class="gallery-dialog-footer">
    <span>← → <span class="gallery-keyboard-hint">to explore</span></span
    ><span>Swipe or use the arrows</span><span>Esc <span class="gallery-keyboard-hint">to close</span></span>
  </div>
</dialog>
