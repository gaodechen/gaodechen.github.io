{% if site.enable_google_analytics and site.google_analytics and site.google_analytics != empty %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics | escape }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', {{ site.google_analytics | jsonify }});
  </script>
{% endif %}
